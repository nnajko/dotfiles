@import "catppuccin-mocha"

* {
  selected-active-foreground:  @background;
  lightfg:                     @text;
  separatorcolor:              @foreground;
  urgent-foreground:           @red;
  alternate-urgent-background: @lightbg;
  lightbg:                     @mantle;
  background-color:            transparent;
  border-color:                @foreground;
  normal-background:           transparent;
  selected-urgent-background:  @red;
  alternate-active-background: @lightbg;
  spacing:                     2;
  alternate-normal-foreground: @foreground;
  urgent-background:           transparent;
  selected-normal-foreground:  @sky;
  active-foreground:           @blue;
  background:                  @base;
  selected-active-background:  @blue;
  active-background:           transparent;
  selected-normal-background:  rgba(116, 199, 236, 0.18);
  alternate-normal-background: transparent;
  foreground:                  @text;
  selected-urgent-foreground:  @background;
  normal-foreground:           @foreground;
  alternate-urgent-foreground: @red;
  alternate-active-foreground: @blue;
  font: "CaskaydiaCove Nerd Font 12";
  g-spacing: 10px;
  g-margin: 0;
  b-radius: 8px;
  g-padding: 8px;
  w-border: 2px solid;
  w-border-color: rgba(116, 199, 236, 0.45);
  w-padding: 12px;
}

configuration {
    modi: "drun,window,calc";
    show-icons: true;
    display-window: "  ";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    display-drun: " ";
}

element {
    padding: @g-padding;
    cursor:  pointer;
    spacing: @g-spacing;
    border:  0;
    border-radius: @b-radius;
}

element normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}

element normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

element normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}

element selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

element selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}

element selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}

element alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}

element alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}

element alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}

element-text {
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}

element-icon {
    background-color: transparent;
    size:             1.2em;
    cursor:           inherit;
    text-color:       inherit;
}

window {
    padding:          @w-padding;
    background-color: rgba(30, 30, 46, 0.82);
    border:           @w-border;
    border-color:     @w-border-color;
    border-radius:    12px;
}

mainbox {
    padding: @g-padding;
    spacing: @g-spacing;
    margin: @g-margin;
    children: ["inputbar", "listview", "message"];
}

message {
    padding:      1px ;
    border-color: @separatorcolor;
}

textbox {
    text-color: @foreground;
}

listview {
    columns: 1;
    lines: 10;
    scrollbar: false;
    fixed-height: true;
    fixed-columns: true;
    border:       0px solid;
}

button {
    cursor:     pointer;
    spacing:    0;
    text-color: @normal-foreground;
}

button selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

num-filtered-rows {
    expand:     false;
    text-color: @overlay0;
}

num-rows {
    expand:     false;
    text-color: @overlay0;
}

textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: @overlay0;
}

inputbar {
    spacing:    @g-spacing;
    padding:    10px 14px;
    border-radius: 999px;
    background-color: rgba(49, 50, 68, 0.75);
    text-color: @normal-foreground;
    children: ["prompt", "entry"];
}

case-indicator {
    text-color: @normal-foreground;
}

entry {
    text-color:        @normal-foreground;
    cursor:            text;
    placeholder-color: @overlay1;
    placeholder:       "Search";
}

prompt {
    text-color: @sapphire;
}
